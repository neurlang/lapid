// Attention for few queries (decoder), split over keys ("flash decoding").
// One 256-thread block per (batch, head, query, chunk of 64 keys):
//   scores: warp w takes keys w, w + 8, ...; lanes stride the head dim (coalesced rows),
//           warp butterfly sum;
//   softmax of the chunk: every warp computes max / exp / sum redundantly from shared
//           memory (lane owns keys lane and lane + 32), so no extra barrier is needed;
//   P V: threads split as (key group g < G, dim lane) and reduce the G partials.
// DIRECT (one chunk covers all keys): normalize and write the output. Otherwise write the
// partial (m, l, o[D]) to scratch; `attn_merge` combines the chunks.
// Head dim D is baked in (constant trip counts, predicated loads, unrolled by ptxas).
// "No score" is the lowest finite f32; real -inf mask values compare below it.
// Params: [B, H, sq, sk, d, scale_bits, nsplit, q(off, s0..s3), k(..), v(..), mask(..)?]
.shared .align 16 .f32 qsh[256];
.shared .align 16 .f32 dots[64];
.shared .align 16 .f32 pp[64];
.shared .align 16 .f32 part[256];

.visible .entry lapid_main(
{{ARGS}}
)
{
    .reg .pred %p, %pv;
    .reg .b32 %tx, %lane, %warp, %item, %NS, %split, %bhq, %qi, %bh, %h, %b, %H, %SQ, %SK;
    .reg .b32 %qbase, %kbase, %vbase, %ks, %kd, %vs, %vd, %kend, %k0, %kn, %u, %c, %kj, %kc, %kr, %dd, %t, %a;
    .reg .b32 %grp, %dl;
    .reg .s32 %st;
    .reg .b64 %rd_s;
    .reg .f32 %scale, %x, %kv, %qv, %sh, %m, %l, %sc0, %sc1, %p0, %p1, %acc, %pt, %vv, %tot;
// #if MASK
    .reg .b32 %mrow, %mstep;
    .reg .f32 %mv;
// #endif
{{PTRS}}
    mov.u32 %tx, %tid.x;
    and.b32 %lane, %tx, 31;
    shr.u32 %warp, %tx, 5;
    mov.u32 %item, %ctaid.x;
    ld.param.u32 %H, [P+4];
    ld.param.u32 %SQ, [P+8];
    ld.param.u32 %SK, [P+12];
    ld.param.f32 %scale, [P+20];
    ld.param.u32 %NS, [P+24];
    rem.u32 %split, %item, %NS;
    div.u32 %bhq, %item, %NS;
    rem.u32 %qi, %bhq, %SQ;
    div.u32 %bh, %bhq, %SQ;
    rem.u32 %h, %bh, %H;
    div.u32 %b, %bh, %H;
    ld.param.u32 %qbase, [P+28];
    ld.param.u32 %t, [P+32];
    mad.lo.u32 %qbase, %b, %t, %qbase;
    ld.param.u32 %t, [P+36];
    mad.lo.u32 %qbase, %h, %t, %qbase;
    ld.param.u32 %t, [P+40];
    mad.lo.u32 %qbase, %qi, %t, %qbase;
    ld.param.u32 %kbase, [P+48];
    ld.param.u32 %t, [P+52];
    mad.lo.u32 %kbase, %b, %t, %kbase;
    ld.param.u32 %t, [P+56];
    mad.lo.u32 %kbase, %h, %t, %kbase;
    ld.param.u32 %ks, [P+60];
    ld.param.u32 %kd, [P+64];
    ld.param.u32 %vbase, [P+68];
    ld.param.u32 %t, [P+72];
    mad.lo.u32 %vbase, %b, %t, %vbase;
    ld.param.u32 %t, [P+76];
    mad.lo.u32 %vbase, %h, %t, %vbase;
    ld.param.u32 %vs, [P+80];
    ld.param.u32 %vd, [P+84];
// #if MASK
    ld.param.u32 %mrow, [P+88];
    ld.param.u32 %t, [P+92];
    mad.lo.u32 %mrow, %b, %t, %mrow;
    ld.param.u32 %t, [P+96];
    mad.lo.u32 %mrow, %h, %t, %mrow;
    ld.param.u32 %t, [P+100];
    mad.lo.u32 %mrow, %qi, %t, %mrow;
    ld.param.u32 %mstep, [P+104];
// #endif
// #if CAUSAL
    add.s32 %st, %qi, 1;
    add.s32 %st, %st, %SK;
    sub.s32 %st, %st, %SQ;
    max.s32 %st, %st, 0;
    min.s32 %st, %st, %SK;
    mov.b32 %kend, %st;
// #endif
// #if !CAUSAL
    mov.u32 %kend, %SK;
// #endif
    shl.b32 %k0, %split, 6;
    sub.u32 %kn, %kend, %k0;
    min.u32 %kn, %kn, 64;
    setp.gt.u32 %p, %kend, %k0;
    selp.b32 %kn, %kn, 0, %p;
    // nothing visible in this chunk (also sk == 0): write the empty result
    setp.eq.u32 %p, %kn, 0;
    @%p bra EMPTY;

    // q * scale -> shared
    setp.ge.u32 %p, %tx, {{D}};
    @%p bra Q_DONE;
    ld.param.u32 %t, [P+44];
    mad.lo.u32 %t, %tx, %t, %qbase;
{{LOAD_Q}}
    mul.f32 %qv, %qv, %scale;
    mov.u32 %a, qsh;
    mad.lo.u32 %a, %tx, 4, %a;
    st.shared.f32 [%a], %qv;
Q_DONE:
    bar.sync 0;

    // scores of keys warp + 8u
    mov.u32 %u, 0;
SC_LOOP:
    mad.lo.u32 %kj, %u, 8, %warp;
    setp.lt.u32 %pv, %kj, %kn;
    selp.b32 %kc, %kj, 0, %pv;
    add.u32 %kr, %k0, %kc;
    mad.lo.u32 %kr, %kr, %ks, %kbase;
    mov.f32 %x, 0f00000000;
    mov.u32 %c, 0;
SC_D:
    mad.lo.u32 %dd, %c, 32, %lane;
    setp.lt.u32 %p, %dd, {{D}};
    selp.b32 %dd, %dd, 0, %p;
    mad.lo.u32 %t, %dd, %kd, %kr;
{{LOAD_K}}
    mov.u32 %a, qsh;
    mad.lo.u32 %a, %dd, 4, %a;
    ld.shared.f32 %qv, [%a];
    selp.f32 %qv, %qv, 0f00000000, %p;
    fma.rn.f32 %x, %qv, %kv, %x;
    add.u32 %c, %c, 1;
    setp.lt.u32 %p, %c, {{DC}};
    @%p bra SC_D;
    shfl.sync.bfly.b32 %sh, %x, 16, 31, -1;
    add.f32 %x, %x, %sh;
    shfl.sync.bfly.b32 %sh, %x, 8, 31, -1;
    add.f32 %x, %x, %sh;
    shfl.sync.bfly.b32 %sh, %x, 4, 31, -1;
    add.f32 %x, %x, %sh;
    shfl.sync.bfly.b32 %sh, %x, 2, 31, -1;
    add.f32 %x, %x, %sh;
    shfl.sync.bfly.b32 %sh, %x, 1, 31, -1;
    add.f32 %x, %x, %sh;
    setp.eq.u32 %p, %lane, 0;
    mov.u32 %a, dots;
    mad.lo.u32 %a, %kj, 4, %a;
    @%p st.shared.f32 [%a], %x;
    add.u32 %u, %u, 1;
    setp.lt.u32 %p, %u, 8;
    @%p bra SC_LOOP;
    bar.sync 0;

    // chunk softmax (every warp): lane owns keys lane and lane + 32
    mov.u32 %a, dots;
    mad.lo.u32 %a, %lane, 4, %a;
    ld.shared.f32 %sc0, [%a];
    ld.shared.f32 %sc1, [%a+128];
// #if MASK
    add.u32 %t, %k0, %lane;
    min.u32 %t, %t, %SK;
    sub.u32 %c, %SK, 1;
    min.u32 %t, %t, %c;
    mad.lo.u32 %t, %t, %mstep, %mrow;
{{LOAD_M}}
    add.f32 %sc0, %sc0, %mv;
    add.u32 %t, %k0, %lane;
    add.u32 %t, %t, 32;
    min.u32 %t, %t, %c;
    mad.lo.u32 %t, %t, %mstep, %mrow;
{{LOAD_M}}
    add.f32 %sc1, %sc1, %mv;
// #endif
    setp.lt.u32 %p, %lane, %kn;
    selp.f32 %sc0, %sc0, 0fFF7FFFFF, %p;
    add.u32 %t, %lane, 32;
    setp.lt.u32 %p, %t, %kn;
    selp.f32 %sc1, %sc1, 0fFF7FFFFF, %p;
    max.f32 %m, %sc0, %sc1;
    shfl.sync.bfly.b32 %sh, %m, 16, 31, -1;
    max.f32 %m, %m, %sh;
    shfl.sync.bfly.b32 %sh, %m, 8, 31, -1;
    max.f32 %m, %m, %sh;
    shfl.sync.bfly.b32 %sh, %m, 4, 31, -1;
    max.f32 %m, %m, %sh;
    shfl.sync.bfly.b32 %sh, %m, 2, 31, -1;
    max.f32 %m, %m, %sh;
    shfl.sync.bfly.b32 %sh, %m, 1, 31, -1;
    max.f32 %m, %m, %sh;
    // p = exp(sc - m) for real scores (0 for padding and when nothing is visible)
    sub.f32 %p0, %sc0, %m;
    mul.f32 %p0, %p0, 0f3FB8AA3B;
    ex2.approx.f32 %p0, %p0;
    sub.f32 %p1, %sc1, %m;
    mul.f32 %p1, %p1, 0f3FB8AA3B;
    ex2.approx.f32 %p1, %p1;
    setp.gt.f32 %pv, %m, 0fFF7FFFFF;
    setp.lt.and.u32 %p, %lane, %kn, %pv;
    selp.f32 %p0, %p0, 0f00000000, %p;
    setp.lt.and.u32 %p, %t, %kn, %pv;
    selp.f32 %p1, %p1, 0f00000000, %p;
    add.f32 %l, %p0, %p1;
    shfl.sync.bfly.b32 %sh, %l, 16, 31, -1;
    add.f32 %l, %l, %sh;
    shfl.sync.bfly.b32 %sh, %l, 8, 31, -1;
    add.f32 %l, %l, %sh;
    shfl.sync.bfly.b32 %sh, %l, 4, 31, -1;
    add.f32 %l, %l, %sh;
    shfl.sync.bfly.b32 %sh, %l, 2, 31, -1;
    add.f32 %l, %l, %sh;
    shfl.sync.bfly.b32 %sh, %l, 1, 31, -1;
    add.f32 %l, %l, %sh;
    setp.eq.u32 %p, %warp, 0;
    mov.u32 %a, pp;
    mad.lo.u32 %a, %lane, 4, %a;
    @%p st.shared.f32 [%a], %p0;
    @%p st.shared.f32 [%a+128], %p1;
    bar.sync 0;

    // P V: thread (grp, dl) sums keys grp, grp + G, ...
    div.u32 %grp, %tx, {{D}};
    rem.u32 %dl, %tx, {{D}};
    mov.f32 %acc, 0f00000000;
    setp.ge.u32 %p, %grp, {{G}};
    @%p bra V_DONE;
    mov.u32 %u, 0;
V_LOOP:
    mad.lo.u32 %kj, %u, {{G}}, %grp;
    setp.lt.u32 %pv, %kj, %kn;
    selp.b32 %kc, %kj, 0, %pv;
    mov.u32 %a, pp;
    mad.lo.u32 %a, %kc, 4, %a;
    ld.shared.f32 %pt, [%a];
    selp.f32 %pt, %pt, 0f00000000, %pv;
    add.u32 %t, %k0, %kc;
    mad.lo.u32 %t, %t, %vs, %vbase;
    mad.lo.u32 %t, %dl, %vd, %t;
{{LOAD_V}}
    fma.rn.f32 %acc, %pt, %vv, %acc;
    add.u32 %u, %u, 1;
    setp.lt.u32 %p, %u, {{VT}};
    @%p bra V_LOOP;
V_DONE:
    mov.u32 %a, part;
    mad.lo.u32 %a, %tx, 4, %a;
    st.shared.f32 [%a], %acc;
    bar.sync 0;
    setp.ge.u32 %p, %tx, {{D}};
    @%p bra DONE;
    mov.f32 %tot, 0f00000000;
    mov.u32 %u, 0;
SUM_LOOP:
    mad.lo.u32 %t, %u, {{D}}, %tx;
    mov.u32 %a, part;
    mad.lo.u32 %a, %t, 4, %a;
    ld.shared.f32 %x, [%a];
    add.f32 %tot, %tot, %x;
    add.u32 %u, %u, 1;
    setp.lt.u32 %p, %u, {{G}};
    @%p bra SUM_LOOP;
    bra OUT;
EMPTY:
    mov.f32 %tot, 0f00000000;
    mov.f32 %m, 0fFF7FFFFF;
    mov.f32 %l, 0f00000000;
    setp.ge.u32 %p, %tx, {{D}};
    @%p bra DONE;
OUT:
// #if DIRECT
    div.rn.f32 %x, %tot, %l;
    setp.gt.f32 %p, %l, 0f00000000;
    selp.f32 %x, %x, 0f00000000, %p;
    mad.lo.u32 %t, %bhq, {{D}}, %tx;
{{STORE}}
// #endif
// #if !DIRECT
    mul.lo.u32 %t, %item, {{D2}};
    add.u32 %t, %t, %tx;
    mul.wide.u32 %rd_s, %t, 4;
    add.s64 %rd_s, %rd_s, %g_scr;
    st.global.f32 [%rd_s+8], %tot;
    setp.ne.u32 %p, %tx, 0;
    @%p bra DONE;
    mul.lo.u32 %t, %item, {{D2}};
    mul.wide.u32 %rd_s, %t, 4;
    add.s64 %rd_s, %rd_s, %g_scr;
    st.global.f32 [%rd_s], %m;
    st.global.f32 [%rd_s+4], %l;
// #endif
DONE:
    ret;
}
